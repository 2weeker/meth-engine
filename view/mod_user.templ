package view

import "strconv"

templ ModUser(p ModPage) {
	if p.Status != "" {
		<p class="mod_status">{ p.Status }</p>
	}
	<div class="panel">
		<table class="user_table">
			<tr class="user_table_row">
				<th class="user_table_header">ID</th>
				<th class="user_table_header">Username</th>
			</tr>
			for _, u := range p.Users {
				<tr class="user_table_row">
					<td class="user_table_data">{ strconv.FormatInt(u.ID, 10) }</td>
					<td class="user_table_data">{ u.Username }</td>
				</tr>
			}
		</table>
		<form action="/user/delete" method="post">
			<input type="hidden" name="_csrf" value={ p.CSRF }/>
			<input type="text" name="username" id="username_del" placeholder="username"/>
			<input type="submit" value="delete" id="delete"/>
		</form>
		<form action="/user/create" method="post">
			<input type="hidden" name="_csrf" value={ p.CSRF }/>
			<input type="text" name="username" id="username" placeholder="username"/>
			<input type="password" name="password" id="password" placeholder="password"/>
			<input type="submit" value="create" id="create"/>
		</form>
	</div>
}
