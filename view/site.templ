package view

import (
	"strconv"

	"meth-enginev2/config"
)

templ Layout(p Page) {
	<html>
		<head>
			<meta charset="utf-8"/>
			<link rel="stylesheet" type="text/css" href="/css/coffee.css"/>
			<link rel="icon" type="image/gif" href="/favicon.gif"/>
			<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48"/>
			<link rel="icon" type="image/png" href="/favicon.png" sizes="32x32"/>
			<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
			<title>{ p.Site.Title }</title>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="description" content={ p.Site.Description }/>
			<meta name="keywords" content="anonymous,chan,textboard,text board,message board"/>
			<meta property="og:type" content="website"/>
			<meta property="og:site_name" content={ p.Site.Title }/>
			<meta property="og:title" content={ p.Site.Title }/>
			<meta property="og:description" content={ p.Site.Description }/>
			<meta property="og:image" content={ p.BaseURL + p.Site.ShareImagePath() }/>
			if p.Site.ShareImageBuiltIn() {
				<meta property="og:image:type" content="image/png"/>
				<meta property="og:image:width" content={ strconv.Itoa(config.ShareWidth) }/>
				<meta property="og:image:height" content={ strconv.Itoa(config.ShareHeight) }/>
			}
			<meta property="og:image:alt" content={ p.Site.Title + " logo" }/>
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:title" content={ p.Site.Title }/>
			<meta name="twitter:description" content={ p.Site.Description }/>
			<meta name="twitter:image" content={ p.BaseURL + p.Site.ShareImagePath() }/>
			<meta name="twitter:image:alt" content={ p.Site.Title + " logo" }/>
		</head>
		<body>
			@Banner(p)
			@BoardPage(p)
			<div class="corner_controls">
				<a href="/mod" class="corner_button admin_button">admin</a>
			</div>
		</body>
	</html>
}
