package view

templ ModBody(p ModPage) {
	switch p.Screen {
		case "login":
			@ModLogin(p)
		case "panel":
			@ModPanel(p)
		case "delete":
			@ModDelete(p)
		case "filter":
			@ModFilter(p)
		case "ban":
			@ModBan(p)
		case "user":
			@ModUser(p)
		case "tags":
			@ModTags(p)
	}
	if p.Screen != "login" && p.Screen != "panel" {
		<a href="/mod" class="back_link">&larr; Back to the mod panel</a>
	}
}

templ ModLogin(p ModPage) {
	if p.Failed {
		<p class="login_failed">Login failed</p>
	}
	if p.CaptchaFailed {
		<p class="login_failed">Incorrect or expired CAPTCHA</p>
	}
	if p.CaptchaLocked != "" {
		<p class="login_failed">{ p.CaptchaLocked }</p>
	}
	if p.Wait != "" {
		<p class="login_failed">Too many attempts; try again in { p.Wait }</p>
	}
	<div class="panel login_panel">
		<form action="/mod/authenticate" method="post">
			<input type="hidden" name="_csrf" value={ p.CSRF }/>
			<a href="/" class="mod_logo_link"><img class="mod_logo" src={ p.Site.LogoURL() } alt={ p.Site.Title }/></a>
			<input type="text" name="username" id="username" placeholder="username"/>
			<br/>
			<input type="password" name="password" id="password" placeholder="password"/>
			if p.Captcha != nil {
				@CaptchaForm(p.Captcha)
			}
			<input type="submit" value="login" id="login"/>
		</form>
	</div>
	<a href="/" class="back_link">&larr; Back to the board</a>
}

templ ModPanel(p ModPage) {
	<div class="panel">
		<a href={ "/mod/delete?id=" + p.ID + "&ip=" + p.IP }>Delete posts</a><br/>
		<a href={ "/mod/filter?id=" + p.ID + "&ip=" + p.IP }>Manage post filters</a><br/>
		<a href={ "/mod/ban?id=" + p.ID + "&ip=" + p.IP }>Manage bans</a><br/>
		<a href={ "/mod/user?id=" + p.ID + "&ip=" + p.IP }>Manage admin users</a><br/>
		<a href={ "/mod/tags?id=" + p.ID + "&ip=" + p.IP }>Manage tags</a><br/>
		<form action="/mod/logout" method="post">
			<input type="hidden" name="_csrf" value={ p.CSRF }/>
			<input type="submit" value="log out" id="log-out"/>
		</form>
		<a href="/" class="back_link">&larr; Back to the board</a>
	</div>
}

templ ModDelete(p ModPage) {
	if p.Status != "" {
		<p class="mod_status">{ p.Status }</p>
	}
	<div class="panel">
		<form action="/post/delete" method="post">
			<input type="hidden" name="_csrf" value={ p.CSRF }/>
			<input type="number" name="post_id" id="post_id" value={ p.ID }/>
			<input type="submit" value="delete" id="delete"/>
		</form>
	</div>
}
