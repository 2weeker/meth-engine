package view

import "net/url"

type EditorField struct {
	Key, Label, Value string
}

type Editor struct {
	Fields   []EditorField
	Tile     string
	Tiles    []string
	ReturnTo string
	Active   bool
	Invalid  bool
}

templ ThemeEditor(p Page, e Editor) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="utf-8"/>
			<link rel="stylesheet" type="text/css" href={ Stylesheet(p.Theme) }/>
			@templ.Raw(customStyle(p.Palette))
			<link rel="icon" type="image/gif" href="/favicon.gif"/>
			<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48"/>
			<link rel="icon" type="image/png" href="/favicon.png" sizes="32x32"/>
			<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
			<title>{ p.Site.Title }</title>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="robots" content="noindex, nofollow"/>
		</head>
		<body>
			<div class="mod_screen">
				if e.Invalid {
					<p class="mod_status">Those colours were not understood</p>
				}
				<div class="panel theme_editor">
					<p class="theme_editor_intro">Custom theme editor</p>
					<form action="/theme/custom" method="post">
						<input type="hidden" name="_csrf" value={ p.CSRF }/>
						<input type="hidden" name="return_to" value={ e.ReturnTo }/>
						for _, f := range e.Fields {
							<label class="theme_editor_row"><span>{ f.Label }</span><input type="color" name={ f.Key } value={ f.Value }/></label>
						}
						<label class="theme_editor_row">
							<span>Background tile</span>
							<select name="tile">
								for _, t := range e.Tiles {
									<option value={ t } selected?={ t == e.Tile }>{ t }</option>
								}
							</select>
						</label>
						<input type="submit" value="apply"/>
					</form>
					if e.Active {
						<form action="/theme/reset" method="post" class="theme_editor_reset">
							<input type="hidden" name="_csrf" value={ p.CSRF }/>
							<input type="hidden" name="return_to" value={ e.ReturnTo }/>
							<input type="submit" value="back to the theme's own colours"/>
						</form>
					}
				</div>
				<a href={ templ.SafeURL(backHref(e.ReturnTo)) } class="back_link">&larr; Back</a>
			</div>
		</body>
	</html>
}

func backHref(returnTo string) string {
	if returnTo == "" {
		return "/"
	}
	return returnTo
}

func customStyle(css string) string {
	if css == "" {
		return ""
	}
	return "<style>" + css + "</style>"
}

func editorHref(returnTo string) string {
	return "/theme/custom?return_to=" + url.QueryEscape(returnTo)
}
